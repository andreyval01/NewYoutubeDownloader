<UserControl x:Class="YoutubePlaylistDownloader.Help"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FlowDirection="{DynamicResource FlowDirection}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource Help}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
            <TextBlock x:Name="VersionText" FontSize="13" Opacity="0.7" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpIntroTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpIntro}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpDownloadTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpDownload}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpSourcesTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpSources}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpPlaylistsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpPlaylists}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpQueueTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpQueue}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpSettingsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpSettings}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HelpTranscodeTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource HelpTranscode}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
