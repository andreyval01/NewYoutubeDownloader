<UserControl x:Class="YoutubePlaylistDownloader.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FlowDirection="{DynamicResource FlowDirection}">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
        <TextBlock x:Name="AboutRun" FontSize="14" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
