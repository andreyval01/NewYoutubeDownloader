<UserControl x:Class="YoutubePlaylistDownloader.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FlowDirection="{DynamicResource FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="DownloadProgressStackPanel" MaxWidth="920" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <TextBlock x:Name="HeadlineTextBlock" Text="{DynamicResource Loading}" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,16"/>

            <Grid x:Name="CurrentDownloadGrid" Margin="0,0,0,8">
                <Controls:MetroProgressBar Height="22" x:Name="CurrentDownloadProgressBar" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="CurrentDownloadProgressBarTextBlock" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid x:Name="TotalDownloadedGrid" Margin="0,0,0,8">
                <Controls:MetroProgressBar Height="22" x:Name="DownloadedVideosProgressBar" Minimum="0"/>
                <TextBlock x:Name="TotalDownloadsProgressBarTextBlock" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="ConvertingTextBlock" Visibility="Collapsed" FontSize="14"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Visibility="Collapsed" x:Name="DownloadSpeedTextBlock" FontSize="14"
                       Foreground="{DynamicResource MahApps.Brushes.Accent2}" Margin="0,8,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1">
            <Button Click="NyExit_Click" Style="{StaticResource SecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconModern Width="16" Height="16" Kind="ArrowLeft"/>
                    <TextBlock Text="{DynamicResource Back}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="NyBackground_Exit" Style="{StaticResource ActionButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconModern Width="16" Height="16" Kind="InboxIn"/>
                    <TextBlock Text="{DynamicResource DownloadInBackground}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="NyOpenFolder_Click" Style="{StaticResource SecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconModern Width="16" Height="16" Kind="FolderOpen"/>
                    <TextBlock Text="{DynamicResource OpenDestinationFolder}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
