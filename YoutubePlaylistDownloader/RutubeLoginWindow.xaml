<Controls:MetroWindow x:Class="YoutubePlaylistDownloader.RutubeLoginWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                      Title="{DynamicResource SignInToRutube}"
                      Width="980"
                      Height="720"
                      MinWidth="800"
                      MinHeight="560"
                      WindowStartupLocation="CenterOwner"
                      GlowBrush="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="Browser" Grid.Row="0" />
        <DockPanel Grid.Row="1" Margin="10">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" MinWidth="140" Margin="5,0,0,0" Padding="12,6"
                    Content="{DynamicResource SaveRutubeSession}" Click="Save_Click" />
            <Button DockPanel.Dock="Right" MinWidth="100" Margin="5,0,0,0" Padding="12,6"
                    Content="{DynamicResource Cancel}" Click="Cancel_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource RutubeLoginHint}" />
        </DockPanel>
    </Grid>
</Controls:MetroWindow>
